RewriteEngine On

# Deprecated preview host → live site only
RewriteCond %{HTTP_HOST} ^khaki-goldfish-975552\.hostingersite\.com$ [NC]
RewriteRule ^ https://theworldjourney.in%{REQUEST_URI} [R=301,L]

# Enable rewrite log for debugging (comment out in production)
# RewriteLog "logs/rewrite.log"
# RewriteLogLevel 3

# ===== PREVENT REWRITE FOR EXISTING FILES AND DIRECTORIES =====
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ===== REMOVE TRAILING SLASHES =====
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ===== ADMIN PANEL (PROCESS FIRST) =====
# Admin dashboard
RewriteRule ^admin/?$ admin/index.php [NC,L]
# Admin pages: /admin/page-name
RewriteRule ^admin/([a-z0-9\-]+)/?$ admin/$1.php [NC,L,QSA]
# Admin actions: /admin/action/id
RewriteRule ^admin/([a-z0-9\-]+)/([0-9]+)/?$ admin/$1.php?id=$2 [NC,L,QSA]

# ===== API ENDPOINTS =====
# API routes
RewriteRule ^api/([a-z0-9\-]+)/?$ api/$1.php [NC,L,QSA]

# ===== DETAILED/SPECIFIC PAGES (BEFORE GENERAL RULES) =====
# Tour details: /tour/tour-name
RewriteRule ^tour/([a-z0-9\-]+)/?$ tour-details.php?slug=$1 [NC,L,QSA]

# Destination details: /destination/destination-name
RewriteRule ^destination/([a-z0-9\-]+)/?$ destination-details.php?slug=$1 [NC,L,QSA]

# Blog post with slug: /blog-post/post-name (but not /blog/)
RewriteRule ^blog-post/([a-z0-9\-]+)/?$ blog-post.php?slug=$1 [NC,L,QSA]

# ===== FILTERED PAGES =====
# Tours by category: /tours/category/category-name
RewriteRule ^tours/category/([a-z0-9\-]+)/?$ tours.php?category=$1 [NC,L,QSA]

# Tours by destination: /tours/destination/destination-name
RewriteRule ^tours/destination/([a-z0-9\-]+)/?$ tours.php?destination=$1 [NC,L,QSA]

# Tours by difficulty: /tours/difficulty/easy|moderate|difficult
RewriteRule ^tours/difficulty/(easy|moderate|difficult)/?$ tours.php?difficulty=$1 [NC,L,QSA]

# Tours search: /tours/search/query
RewriteRule ^tours/search/([^/]+)/?$ tours.php?search=$1 [NC,L,QSA]

# Blog by category: /blog/category/category-name
RewriteRule ^blog/category/([a-z0-9\-]+)/?$ blog.php?category=$1 [NC,L,QSA]

# Blog search: /blog/search/query
RewriteRule ^blog/search/([^/]+)/?$ blog.php?search=$1 [NC,L,QSA]

# ===== MAIN PAGES =====
# Home page
RewriteRule ^home/?$ index.php [NC,L]

# Tours listing
RewriteRule ^tours/?$ tours.php [NC,L,QSA]

# Destinations listing  
RewriteRule ^destinations/?$ destinations.php [NC,L,QSA]

# Blog listing
RewriteRule ^blog/?$ blog.php [NC,L,QSA]

# Contact page
RewriteRule ^contact/?$ contact.php [NC,L]

# Booking page
RewriteRule ^booking/?$ booking.php [NC,L,QSA]

# Cart page
RewriteRule ^cart/?$ cart.php [NC,L,QSA]

# Book with tour ID: /book/123 → add to cart
RewriteRule ^book/([0-9]+)/?$ cart.php?add_tour=$1 [NC,L,QSA]

# Invoice pages
RewriteRule ^invoice/([A-Za-z0-9\-]+)/?$ invoice.php?number=$1 [NC,L,QSA]
RewriteRule ^pay-invoice/([A-Za-z0-9\-]+)/?$ pay-invoice.php?number=$1 [NC,L,QSA]

# User authentication
RewriteRule ^login/?$ login.php [NC,L]
RewriteRule ^register/?$ register.php [NC,L]
RewriteRule ^logout/?$ logout.php [NC,L]
RewriteRule ^profile/?$ profile.php [NC,L]
RewriteRule ^user-dashboard/?$ user-dashboard.php [NC,L]

# About Us page
RewriteRule ^about-us/?$ about-us.php [NC,L]
RewriteRule ^about/?$ about-us.php [NC,L]

# Privacy Policy page
RewriteRule ^privacy-policy/?$ privacy-policy.php [NC,L]

# Terms and Conditions page
RewriteRule ^terms-conditions/?$ terms-conditions.php [NC,L]

# Gallery
RewriteRule ^gallery/?$ gallery.php [NC,L]

# ===== FALLBACK RULES =====
# Remove .php extension for direct file access (if file exists with .php)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ===== SECURITY RULES =====
# Deny access to sensitive directories
RewriteRule ^config/ - [F,L]
RewriteRule ^classes/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^vendor/ - [F,L]

# Deny access to sensitive files
RewriteRule \.(sql|log|ini|conf)$ - [F,L]
RewriteRule ^\. - [F,L]

# ===== PERFORMANCE & SEO =====
# Force HTTPS (uncomment for production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www (uncomment if needed)
# RewriteCond %{HTTP_HOST} ^www\.(.*)
# RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ===== ERROR PAGES =====
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
